<?xml version="1.0" encoding="utf-8"?>
<!--
  Registers BackgrounderInitializer with androidx.startup so Backgrounder.shared
  is populated before Application.onCreate. Merges into the consumer's
  InitializationProvider entry; a consumer that removes WorkManager's own
  initializer with tools:node="remove" on that meta-data (required for
  Configuration.Provider) keeps ours. A consumer that removes the whole
  provider must call Backgrounder.configure(application) instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false">
            <meta-data
                android:name="com.happycodelucky.backgrounder.BackgrounderInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
