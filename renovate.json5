// Backgrounder — Renovate configuration.
//
// Automates CLAUDE.md §2's "use the latest stable, web-search before
// bumping" policy: Renovate opens a PR when a dependency in
// gradle/libs.versions.toml (or a GitHub Action) has a newer stable
// release, and CI's full check gates the merge.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  packageRules: [
    {
      // CLAUDE.md §2 / §13: never EAP / RC / beta / alpha on main. Renovate's
      // default versioning already prefers stable, but Kotlin-ecosystem
      // pre-releases use suffixes it can misread — be explicit.
      matchManagers: ['gradle'],
      ignoreUnstable: true,
    },
    {
      // Kotlin is bounded above by SKIE's supported range (CLAUDE.md §8:
      // "If SKIE doesn't yet support a Kotlin version, we wait"). A Kotlin
      // bump must be a deliberate, human-paired change with the SKIE pin —
      // Renovate must not propose it on its own. The pattern also covers the
      // kotlin-serialization plugin, which versions in lockstep with Kotlin.
      // Anchored at a `.`/`:` boundary: a bare `org.jetbrains.kotlin` prefix
      // also matches `org.jetbrains.kotlinx`, which would silently freeze
      // coroutines / serialization / atomicfu too.
      matchPackageNames: ['/^org\\.jetbrains\\.kotlin([.:]|$)/'],
      enabled: false,
      description: 'Kotlin pin is SKIE-bound; bump manually together with the skie version.',
    },
    {
      // SKIE bumps are welcome — they're what eventually unlocks a Kotlin
      // bump. Label them so the paired manual Kotlin review is prompted.
      matchPackageNames: ['/^co\\.touchlab\\.skie([.:]|$)/'],
      labels: ['skie', 'check-kotlin-pin'],
    },
  ],
}
